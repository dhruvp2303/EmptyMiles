# EmptyMiles Production Environment Configuration Template
# Copy to .env.local for local development

# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://emptymiles_user:password@localhost:5432/emptymiles_db?sslmode=prefer"

# Redis Cache & Message Queue (BullMQ)
REDIS_URL="redis://localhost:6379"

# Google Maps Platform API Key (Geocoding, Directions & Radar)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyPlaceholderKeyForMaps"

# Razorpay B2B Escrow & Settlement Gateway
RAZORPAY_KEY_ID="rzp_test_placeholderKeyId"
RAZORPAY_KEY_SECRET="placeholderSecretKey"
RAZORPAY_WEBHOOK_SECRET="whsec_placeholderWebhookSecret"

# Transactional Email Provider (Resend / AWS SES)
EMAIL_PROVIDER_API_KEY="re_placeholderEmailApiKey"
EMAIL_FROM="EmptyMiles Dispatch <dispatch@emptymiles.in>"

# Authentication & Session Security
NEXTAUTH_SECRET="super-secret-random-32-character-jwt-key"
NEXTAUTH_URL="http://localhost:3000"

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID="emptymiles-prod"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@emptymiles-prod.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3\n-----END PRIVATE KEY-----"
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyPlaceholderFirebaseKey"

# Secure Object Storage (S3 / Cloud Storage for Digital POD & KYC)
STORAGE_BUCKET="emptymiles-pod-documents-prod"
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="ap-south-1"
